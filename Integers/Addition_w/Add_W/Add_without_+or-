public class Main {
    public static int getSum(int a, int b) {
        while (b != 0) {
            int carry = a & b; // Carry bits
            a = a ^ b;         // Sum without carry
            b = carry << 1;    // Carry shifted to the correct position
        }
        return a;
    }

    public static void main(String[] args) {
        System.out.println(getSum(5, 7));   // 12
        System.out.println(getSum(-3, 5));  // 2
    }
}
